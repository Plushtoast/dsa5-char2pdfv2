{{#if snapshot.melee.length}}
<div class="sheet-block">
  <h2>{{labels.melee}}</h2>
  <table class="sheet-table" data-split>
    <thead>
      <tr>
        <th>{{labels.name}}</th>
        <th>{{labels.combat}}</th>
        <th>{{labels.damage}}</th>
        <th>{{labels.at}}</th>
        <th>{{labels.pa}}</th>
        <th>{{labels.reach}}</th>
        <th>{{labels.weight}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each snapshot.melee}}
      <tr>
        <td class="pdf-field" data-pdf-field="melee.{{@index}}.name">{{name}}</td>
        <td class="pdf-field" data-pdf-field="melee.{{@index}}.combatskill">{{combatskill}}</td>
        <td class="pdf-field" data-pdf-field="melee.{{@index}}.damage">{{damage}}</td>
        <td class="pdf-field" data-pdf-field="melee.{{@index}}.at" data-pdf-align="center">{{at}}</td>
        <td class="pdf-field" data-pdf-field="melee.{{@index}}.pa" data-pdf-align="center">{{pa}}</td>
        <td class="pdf-field" data-pdf-field="melee.{{@index}}.reach">{{reach}}</td>
        <td class="pdf-field" data-pdf-field="melee.{{@index}}.weight" data-pdf-align="center">{{weight}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{/if}}
