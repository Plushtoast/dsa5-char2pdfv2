<div class="derived-grid sheet-block">
  <div class="derived-cell is-lp"><span>{{snapshot.derived.lp.abbrev}}</span><b class="pdf-field" data-pdf-field="derived.lp">{{snapshot.derived.lp.value}} / {{snapshot.derived.lp.max}}</b></div>
  <div class="derived-cell is-ae"><span>{{snapshot.derived.ae.abbrev}}</span><b class="pdf-field" data-pdf-field="derived.ae">{{snapshot.derived.ae.value}} / {{snapshot.derived.ae.max}}</b></div>
  <div class="derived-cell is-kp"><span>{{snapshot.derived.kp.abbrev}}</span><b class="pdf-field" data-pdf-field="derived.kp">{{snapshot.derived.kp.value}} / {{snapshot.derived.kp.max}}</b></div>
  <div class="derived-cell"><span>{{snapshot.derived.spi.abbrev}}</span><b class="pdf-field" data-pdf-field="derived.spi">{{snapshot.derived.spi.max}}</b></div>
  <div class="derived-cell"><span>{{snapshot.derived.tou.abbrev}}</span><b class="pdf-field" data-pdf-field="derived.tou">{{snapshot.derived.tou.max}}</b></div>
  <div class="derived-cell"><span>{{snapshot.derived.dodge.abbrev}}</span><b class="pdf-field" data-pdf-field="derived.dodge">{{snapshot.derived.dodge.max}}</b></div>
  <div class="derived-cell"><span>{{snapshot.derived.mov.abbrev}}</span><b class="pdf-field" data-pdf-field="derived.mov">{{snapshot.derived.mov.value}}</b></div>
  <div class="derived-cell"><span>{{snapshot.derived.ini.abbrev}}</span><b class="pdf-field" data-pdf-field="derived.ini">{{snapshot.derived.ini.value}}</b></div>
</div>
<div class="meta-grid sheet-block">
  <div><span>{{labels.fate}}</span><b class="pdf-field" data-pdf-field="meta.fate">{{snapshot.fate.value}} / {{snapshot.fate.max}}</b></div>
  <div><span>{{labels.experience}}</span><b class="pdf-field" data-pdf-field="meta.experience">{{snapshot.experience.grade}}</b></div>
  <div><span>{{labels.apTotal}}</span><b class="pdf-field" data-pdf-field="meta.apTotal">{{snapshot.experience.total}}</b></div>
  <div><span>{{labels.apSpent}}</span><b class="pdf-field" data-pdf-field="meta.apSpent">{{snapshot.experience.spent}}</b></div>
  <div><span>{{labels.apCurrent}}</span><b class="pdf-field" data-pdf-field="meta.apCurrent">{{snapshot.experience.current}}</b></div>
</div>
